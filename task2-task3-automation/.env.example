# Copy to .env and adjust if PetClinic runs somewhere other than the default
# Docker Compose setup on this same machine (localhost:8081 UI / :8080 API).

UI_BASE_URL=http://host.docker.internal:8081
API_BASE_URL=http://host.docker.internal:8080

# Leave these two alone unless you know why you're changing them — see
# PetClinicPageTest.cs for why the browser needs to address the app as
# "localhost" specifically (PetClinic's CORS policy rejects host.docker.internal
# as an Origin), while PLAYWRIGHT_RESOLVE_LOCALHOST_TO is what makes that
# "localhost" actually reach the host machine from inside the container.
# UI_BROWSER_URL=http://localhost:8081
# PLAYWRIGHT_RESOLVE_LOCALHOST_TO=host.docker.internal
